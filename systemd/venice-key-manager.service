[Unit]
Description=Venice Key Manager Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/venice-key-manager
EnvironmentFile=/etc/venice-key-manager/venice.env
ExecStart=/usr/bin/python3 -m venice_key_manager.cli web --host 0.0.0.0 --port 8660
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
