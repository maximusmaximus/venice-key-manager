[Unit]
Description=Venice Key Manager Podman Container
After=network-online.target

[Container]
Image=docker.io/library/python:3.12-slim
ContainerName=venice-key-manager
EnvironmentFile=/etc/venice-key-manager/venice.env
Volume=/var/lib/venice-key-manager/data:/app/data:Z
Volume=/opt/venice-key-manager:/app:ro,Z
PublishPort=127.0.0.1:8660:8660
Exec=python3 -m venice_key_manager.cli web --host 0.0.0.0 --port 8660

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
