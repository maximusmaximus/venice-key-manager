# ==============================================================================
# Venice Key Manager - Environment Configuration Template
# ==============================================================================

# Master Venice.ai API Key (Admin type required for key management)
# Obtain from https://venice.ai/settings/api
VENICE_API_KEY=your_venice_admin_api_key_here

# Venice API Base URL (default: https://api.venice.ai/api/v1)
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Web Dashboard Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8660
WEB_SECRET_KEY=change_me_to_a_random_secure_string

# Inference & Budget Alert Warnings (USD)
# Warning triggered when account balance or remaining key budget drops below this amount
LOW_USD_WARNING_THRESHOLD=0.20

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram User IDs allowed to access management actions
TELEGRAM_ALLOWED_USERS=

# MCP Server Configuration
MCP_PORT=8661

# Data Directory for Local Metadata, Categories & Backups
DATA_DIR=./data
