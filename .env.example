# ==============================================================================
# Venice Key Manager & Telegram Agent Suite - Environment Configuration
# ==============================================================================

# Master Venice.ai API Key (Admin type required for key management)
# Obtain from https://venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key_here
VENICE_ADMIN_KEY=your_venice_admin_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=deepseek-v4-flash

# Web Dashboard Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8844
WEB_SECRET_KEY=change_me_to_a_random_secure_string

# Telegram Bot Controller Credentials
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALLOWED_USERS=123456789

# Telegram MTProto (Optional for automated @BotFather creation)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Target Agent Configuration File
AGENT_CONFIG_PATH=config.yaml

# Inference & Budget Alert Warnings (USD)
LOW_USD_WARNING_THRESHOLD=0.20

# Data Directory for Local Metadata, Categories & Backups
DATA_DIR=./data
